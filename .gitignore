# environments (rebuild per machine, see init.md §4)
envs/
.venv/
__pycache__/
*.pyc

# secrets
.env
*.key
roboflow.json

# downloaded code (re-cloned at pinned commits, see init.md §5)
code/gbh-yolov5/
code/yolov5-v7.0/

# datasets (re-downloaded; keep frozen splits + manifests)
datasets/*
!datasets/.gitkeep
!datasets/splits/
!datasets/raw/
datasets/raw/*/*
datasets/raw/PV-Multi-Defect/
datasets/raw/elpv-dataset/
!datasets/raw/*/MANIFEST.txt

# weights (keep checksums only)
weights/*
!weights/SHA256SUMS
*.pt
*.pth
*.onnx

# final trained models: tracked with Git LFS (see .gitattributes, models/README.md)
!models/**/*.pt

# training outputs (keep summaries, sanity images, and the text/plot outputs of final P2/P3 runs)
results/*
!results/.gitkeep
!results/summary.csv
!results/summary.md
!results/sanity/
!results/p1/
!results/p2/
!results/p3/
results/p2/yolov8n.pt
results/p3/cnn_smoke*
results/p3/*.stdout
results/**/*.jpg
results/**/*.h5
results/**/*.npz
results/**/ckpt_stage*/
results/**/events.out.tfevents*
!results/**/*.log
runs/
wandb/
*.log
nohup.out
