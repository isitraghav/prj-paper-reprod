# environments (rebuild per machine, see init.md §4)
envs/
.venv/
__pycache__/
*.pyc

# secrets
.env
*.key
roboflow.json

# downloaded code (re-cloned at pinned commits, see init.md §5)
code/gbh-yolov5/
code/yolov5-v7.0/

# datasets (re-downloaded; keep frozen splits + manifests)
datasets/*
!datasets/.gitkeep
!datasets/splits/
!datasets/raw/
datasets/raw/*/*
datasets/raw/PV-Multi-Defect/
datasets/raw/elpv-dataset/
!datasets/raw/*/MANIFEST.txt

# weights (keep checksums only)
weights/*
!weights/SHA256SUMS
*.pt
*.pth
*.onnx

# final trained models: tracked with Git LFS (see .gitattributes, models/README.md)
!models/**/*.pt
# intermediate / ablation weights in results (also LFS via .gitattributes)
!results/**/*.pt

# training outputs (keep summaries, sanity images, and the text/plot outputs of final P2/P3 runs)
results/*
!results/.gitkeep
!results/summary.csv
!results/summary.md
!results/dataset_check.md
!results/sanity/
!results/p1/
!results/p2/
!results/p3/
!results/cross/
results/cross/preds*/*.csv
results/cross/tiles*.csv
results/p2/yolov8n.pt
results/p3/cnn_smoke*
results/p3/*.stdout
results/**/*.jpg
results/**/*.h5
results/**/*.npz
results/**/ckpt_stage*/
results/**/events.out.tfevents*
runs/
wandb/
*.log
nohup.out
!results/p[123]/**/*.log
# byte-identical copy of models/p2/yolov5s.pt, kept only because eval_p2.sh reads it from here
results/p2/p2_v5s/weights/
