+class ASFF_Detect(Detect):
+    # P2 re-implementation: ASFF fuses the three PAN outputs (P3, P4, P5) per level before the standard Detect convs.
+    # Subclass of Detect so loss / autoanchor / bias init / export treat it as a Detect head.
+    def __init__(self, nc=80, anchors=(), ch=(), inplace=True):
+        super().__init__(nc, anchors, ch, inplace)
+        self.asff = nn.ModuleList(ASFF(i, ch) for i in range(self.nl))
+
+    def forward(self, x):
+        x = [m(x) for m in self.asff]  # every level fuses the original (unfused) PAN maps
+        return super().forward(x)
+
