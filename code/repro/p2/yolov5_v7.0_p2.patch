@@ -881,6 +881,26 @@ def clip_segments(segments, shape):
         segments[:, 1] = segments[:, 1].clip(0, shape[0])  # y
 
 
+def diou_nms(boxes, scores, iou_thres, max_det=300):
+    # P2 re-implementation: greedy NMS that suppresses a box if DIoU = IoU - rho^2 / c^2 > iou_thres (Zheng et al. 2020).
+    # boxes (n,4) xyxy, already class-offset by the caller. Returns kept indices sorted by score, like torchvision nms.
+    boxes, scores = boxes.float(), scores.float()  # fp16 overflows areas/diagonals > 65504 (torchvision nms is fp32 inside)
+    order = scores.argsort(descending=True)
+    ctr = (boxes[:, :2] + boxes[:, 2:]) / 2
+    area = (boxes[:, 2:] - boxes[:, :2]).clamp(0).prod(1)
+    keep = []
+    while order.numel() and len(keep) < max_det:  # greedy in score order, so stopping at max_det is exact
+        i, rest = order[0], order[1:]
+        keep.append(i)
+        b, r = boxes[i], boxes[rest]
+        inter = (torch.min(b[2:], r[:, 2:]) - torch.max(b[:2], r[:, :2])).clamp(0).prod(1)
+        iou = inter / (area[i] + area[rest] - inter + 1e-7)
+        c2 = ((torch.max(b[2:], r[:, 2:]) - torch.min(b[:2], r[:, :2])) ** 2).sum(1) + 1e-7
+        rho2 = ((ctr[i] - ctr[rest]) ** 2).sum(1)
+        order = rest[iou - rho2 / c2 <= iou_thres]
+    return torch.stack(keep) if keep else order.new_zeros(0)
+
