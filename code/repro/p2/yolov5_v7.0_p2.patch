@@ -858,3 +858,56 @@ class Classify(nn.Module):
         if isinstance(x, list):
             x = torch.cat(x, 1)
         return self.linear(self.drop(self.pool(self.conv(x)).flatten(1)))
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# P2 re-implementation (Mazen et al., IEEE Access 2023): GAM attention and ASFF fusion. Not part of ultralytics v7.0.
+
+class GAM_Attention(nn.Module):
+    # Global Attention Mechanism (Liu et al. 2021, arXiv:2112.05561), P2 Eq. (1):
+    # F2 = Mc(F1) * F1, F3 = Ms(F2) * F2. Channel MLP on the permuted map, 7x7 conv spatial branch.
+    # group=True: grouped 7x7 convs (groups=rate) + channel shuffle, the variant common in YOLO GAM ports.
+    def __init__(self, c1, c2, rate=4, group=False):
+        super().__init__()
+        c_ = int(c1 / rate)
+        g = rate if group else 1
+        self.group = g
+        self.channel_attention = nn.Sequential(nn.Linear(c1, c_), nn.ReLU(inplace=True), nn.Linear(c_, c1))
+        self.spatial_attention = nn.Sequential(nn.Conv2d(c1, c_, 7, padding=3, groups=g), nn.BatchNorm2d(c_),
+                                               nn.ReLU(inplace=True), nn.Conv2d(c_, c2, 7, padding=3, groups=g),
+                                               nn.BatchNorm2d(c2))
+
+    def forward(self, x):
+        b, c, h, w = x.shape
+        att = self.channel_attention(x.permute(0, 2, 3, 1).reshape(b, -1, c)).view(b, h, w, c).permute(0, 3, 1, 2)
+        x = x * att.sigmoid()
+        s = self.spatial_attention(x)
+        if self.group > 1:  # channel shuffle so each group's attention mixes across groups
+            s = s.view(b, self.group, -1, h, w).transpose(1, 2).reshape(b, -1, h, w)
+        return x * s.sigmoid()
+
+
+class ASFF(nn.Module):
+    # Adaptively Spatial Feature Fusion (Liu et al. 2019, arXiv:1911.09516) for one output level, P2 Eq. (5)-(6).
+    # ch = (c_P3, c_P4, c_P5) of the PAN outputs; level 0 = P3 (stride 8), 1 = P4, 2 = P5. Output keeps ch[level].
+    def __init__(self, level, ch, compress_c=16):
+        super().__init__()
+        self.level = level
+        c = ch[level]
+        self.resize = nn.ModuleList()
+        for j, cj in enumerate(ch):
+            if j == level:
+                self.resize.append(nn.Identity())
+            elif j < level:  # higher resolution -> downsample by 2**(level-j)
+                ops = [nn.MaxPool2d(3, 2, 1) for _ in range(level - j - 1)] + [Conv(cj, c, 3, 2)]
+                self.resize.append(nn.Sequential(*ops))
+            else:  # lower resolution -> 1x1 compress, then nearest upsample by 2**(j-level)
+                self.resize.append(nn.Sequential(Conv(cj, c, 1, 1), nn.Upsample(scale_factor=2 ** (j - level))))
+        self.weight = nn.ModuleList(Conv(c, compress_c, 1, 1) for _ in ch)
+        self.weight_levels = nn.Conv2d(compress_c * len(ch), len(ch), 1, 1, 0)
+        self.expand = Conv(c, c, 3, 1)
+
+    def forward(self, xs):
+        r = [m(x) for m, x in zip(self.resize, xs)]
+        w = self.weight_levels(torch.cat([m(x) for m, x in zip(self.weight, r)], 1)).softmax(1)  # alpha+beta+gamma=1
+        return self.expand(sum(x * w[:, i:i + 1] for i, x in enumerate(r)))
